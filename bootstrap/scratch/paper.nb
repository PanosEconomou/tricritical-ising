Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Calculate", " ", "Boundaries", " ", "in", " ", "BDE", " ", "and", " ", 
    "Pull", " ", "back", " ", "to", " ", 
    RowBox[{"TIM", "^", "2"}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Module", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "md", ",", "s", ",", " ", "z", ",", " ", "t", ",", "boundaries", ",", 
       " ", "defects", ",", " ", "x", ",", " ", "xz", ",", " ", "pullbacks", ",",
        "untwisted", ",", "transmission", ",", "S", ",", "T", ",", "Z", ",", 
       "weights"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"md", "=", 
         RowBox[{"ModularDataFoldMinimal", "[", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"s", "=", 
         RowBox[{"Get", "@", 
          RowBox[{"FileNameJoin", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"NotebookDirectory", "[", "]"}], 
             ",", "\"\<AE-maximal-S-matrix.m\>\""}], "}"}], "]"}]}]}], ";"}], 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"t", "=", 
         RowBox[{"Get", "@", 
          RowBox[{"FileNameJoin", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"NotebookDirectory", "[", "]"}], 
             ",", "\"\<AE-maximal-T-matrix.m\>\""}], "}"}], "]"}]}]}], ";"}], 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"weights", "=", 
         RowBox[{"Get", "@", 
          RowBox[{"FileNameJoin", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"NotebookDirectory", "[", "]"}], 
             ",", "\"\<AE-maximal-conformal-weights.m\>\""}], "}"}], 
           "]"}]}]}], ";"}], "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"weights", "//", "Sort"}], "//", "Echo"}], ";"}], 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
        "The", " ", "defects", " ", "in", " ", "here", " ", "to", " ", "find",
          " ", "the", " ", "inverse", " ", "Z2"}], " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"defects", "=", " ", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"#", "/", 
              RowBox[{"#", "[", 
               RowBox[{"[", "1", "]"}], "]"}]}], " ", "&"}], " ", "/@", " ", 
            "s"}], "//", "Simplify"}], "//", "Transpose"}]}], ";"}], 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"S", "=", 
         RowBox[{"Get", "@", 
          RowBox[{"FileNameJoin", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"NotebookDirectory", "[", "]"}], 
             ",", "\"\<S-matrix-su2xsu2-over-su2.m\>\""}], "}"}], "]"}]}]}], 
        ";"}], "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"T", "=", 
         RowBox[{"Get", "@", 
          RowBox[{"FileNameJoin", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"NotebookDirectory", "[", "]"}], 
             ",", "\"\<T-matrix-su2xsu2-over-su2.m\>\""}], "}"}], "]"}]}]}], 
        ";"}], "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"weights", "=", 
         RowBox[{"Get", "@", 
          RowBox[{"FileNameJoin", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"NotebookDirectory", "[", "]"}], 
             ",", "\"\<conformal-weights-su2xsu2-over-su2.m\>\""}], "}"}], 
           "]"}]}]}], ";"}], "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Z", "=", 
         RowBox[{"Get", "@", 
          RowBox[{"FileNameJoin", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"NotebookDirectory", "[", "]"}], 
             ",", "\"\<AE-modular-invariant-su2xsu2-over-su2.m\>\""}], "}"}], 
           "]"}]}]}], ";"}], "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"Z", "//", "MatrixPlot"}], "//", "Echo"}], ";"}], 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"boundaries", " ", "=", " ", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"#", "/", 
              RowBox[{"Sqrt", "[", 
               RowBox[{"#", "[", 
                RowBox[{"[", "1", "]"}], "]"}], "]"}]}], " ", "&"}], " ", "/@",
