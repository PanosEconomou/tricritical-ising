Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Calculate", " ", "Transmissions", " ", "in", " ", "BDE"}], " ", 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Module", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "md", ",", "s", ",", "z", ",", "weights", ",", "n", ",", "ind", ",", 
       " ", "out", ",", " ", "sH", ",", " ", "sR", ",", " ", "bnd", ",", " ", 
       "M", ",", " ", "L", ",", " ", "B", ",", " ", "r", ",", " ", "cv", ",", 
       " ", "xv", ",", " ", "cons", ",", " ", "box", ",", " ", "go"}], "}"}], 
     ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"md", "=", 
       RowBox[{"ModularDataFoldZ2FixedMinimal", "[", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"s", "=", 
       RowBox[{"Get", "@", 
        RowBox[{"FileNameJoin", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"NotebookDirectory", "[", "]"}], 
           ",", "\"\<S-matrix-su2xsu2-over-su2.m\>\""}], "}"}], "]"}]}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"z", "=", 
       RowBox[{"Get", "@", 
        RowBox[{"FileNameJoin", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"NotebookDirectory", "[", "]"}], 
           ",", "\"\<DE-modular-invariant-su2xsu2-over-su2.m\>\""}], "}"}], 
         "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"weights", "=", 
       RowBox[{"Get", "@", 
        RowBox[{"FileNameJoin", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"NotebookDirectory", "[", "]"}], 
           ",", "\"\<conformal-weights-su2xsu2-over-su2.m\>\""}], "}"}], 
         "]"}]}]}], ";", "\[IndentingNewLine]", " ", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"n", "=", 
       RowBox[{"Length", "@", "s"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"ind", "=", 
       RowBox[{
        RowBox[{"Pick", "[", 
         RowBox[{
          RowBox[{"Range", "@", "n"}], ",", 
          RowBox[{"Unitize", "@", 
           RowBox[{"Diagonal", "@", "z"}]}], ",", "1"}], "]"}], "//", 
        "Echo"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"out", "=", 
       RowBox[{"Complement", "[", 
        RowBox[{
         RowBox[{"Range", "@", "n"}], ",", "ind"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"sH", "=", 
       RowBox[{"Conjugate", "@", 
        RowBox[{"N", "[", 
         RowBox[{"s", ",", "40"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"sR", "=", 
       RowBox[{"Re", "@", 
        RowBox[{"N", "@", "s"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"bnd", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Max", "[", 
          RowBox[{
           RowBox[{"sR", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", "ind"}], "]"}], "]"}], "/", 
           RowBox[{"sR", "[", 
            RowBox[{"[", 
             RowBox[{"1", ",", "ind"}], "]"}], "]"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "n"}], "}"}]}], "]"}]}], ";", "\n", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"integer", " ", 
         RowBox[{"lattice", ":", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"S", "*", "x"}], ")"}], "_out"}]}]}], "=", 
        RowBox[{
         RowBox[{"0", " ", "and", " ", "Im", 
          RowBox[{"(", 
           RowBox[{"S", "*", "x"}], ")"}], "_I"}], "=", "0"}]}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"M", "=", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"Re", "@", 
          RowBox[{"sH", "[", 
           RowBox[{"[", "out", "]"}], "]"}]}], ",", 
         RowBox[{"Im", "@", 
          RowBox[{"sH", "[", 
           RowBox[{"[", "out", "]"}], "]"}]}], ",", 
         RowBox[{"Im", "@", 
          RowBox[{"sH", "[", 
           RowBox[{"[", "ind", "]"}], "]"}]}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"L", "=", 
       RowBox[{"LatticeReduce", "@", 
        RowBox[{"Join", "[", 
         RowBox[{
          RowBox[{"IdentityMatrix", "@", "n"}], ",", 
          RowBox[{"Round", "[", 
           RowBox[{
            RowBox[{"10", "^", "25"}], " ", 
            RowBox[{"Transpose", "@", "M"}]}], "]"}], ",", "2"}], "]"}]}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"B", "=", 
       RowBox[{
        RowBox[{"Select", "[", 
         RowBox[{"L", ",", 
          RowBox[{
           RowBox[{
            RowBox[{"Norm", "@", 
             RowBox[{"#", "[", 
              RowBox[{"[", 
               RowBox[{
                RowBox[{"n", "+", "1"}], ";;"}], "]"}], "]"}]}], "<", 
            RowBox[{"10", "^", "10"}]}], "&"}]}], "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", " ", 
          RowBox[{";;", "n"}]}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"r", "=", 
       RowBox[{"Length", "@", "B"}]}], ";", "\n", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "LP", " ", "bounds", " ", "on", " ", "the", " ", "lattice", " ", 
        "coefficients"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"cv", "=", 
       RowBox[{"Array", "[", 
        RowBox[{"\[FormalC]", ",", "r"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"xv", "=", 
       RowBox[{"cv", ".", "B"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"cons", "=", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"Thread", "[", 
          RowBox[{"xv", ">=", "0"}], "]"}], ",", 
         RowBox[{"Thread", "[", 
          RowBox[{"xv", "<=", "bnd"}], "]"}], ",", 
         RowBox[{"Thread", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"sR", "[", 
             RowBox[{"[", "ind", "]"}], "]"}], ".", "xv"}], ">=", "0"}], 
          "]"}]}], "]"}]}], ";", 
      RowBox[{"box", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Ceiling", "[", 
            RowBox[{
             RowBox[{"LinearOptimization", "[", 
              RowBox[{
              "k", ",", "cons", ",", "cv", 
               ",", "\"\<PrimalMinimumValue\>\""}], "]"}], "-", 
             RowBox[{"10", "^", 
              RowBox[{"-", "6"}]}]}], "]"}], ",", 
           RowBox[{"Floor", "[", 
            RowBox[{
             RowBox[{"-", 
              RowBox[{"LinearOptimization", "[", 
               RowBox[{
                RowBox[{"-", "k"}], ",", "cons", ",", "cv", 
                ",", "\"\<PrimalMinimumValue\>\""}], "]"}]}], "+", 
             RowBox[{"10", "^", 
              RowBox[{"-", "6"}]}]}], "]"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", "cv"}], "}"}]}], "]"}]}], ";"}]}], 
    "\[IndentingNewLine]", "\n", 
    RowBox[{"(*", 
     RowBox[{"depth", "-", 
      RowBox[{
      "first", " ", "search", " ", "with", " ", "LP", " ", "pruning"}]}], 
     "*)"}], "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{
       RowBox[{"go", "[", "fixed_", "]"}], ":=", 
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"k", "=", 
            RowBox[{
             RowBox[{"Length", "@", "fixed"}], "+", "1"}]}], ",", "cs", ",", 
           "lo", ",", "hi"}], "}"}], ",", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"k", ">", "r"}], ",", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Min", "[", 
               RowBox[{
                RowBox[{"sR", "[", 
                 RowBox[{"[", "ind", "]"}], "]"}], ".", 
                RowBox[{"(", 
                 RowBox[{"fixed", ".", "B"}], ")"}]}], "]"}], ">", 
              RowBox[{"10", "^", 
               RowBox[{"-", "6"}]}]}], ",", 
             RowBox[{"Sow", "[", 
              RowBox[{"fixed", ".", "B"}], "]"}]}], "]"}], ",", 
           RowBox[{
            RowBox[{"cs", "=", 
             RowBox[{"Join", "[", 
              RowBox[{"cons", ",", 
               RowBox[{"MapThread", "[", 
                RowBox[{"Equal", ",", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"cv", "[", 
                    RowBox[{"[", 
                    RowBox[{";;", 
                    RowBox[{"k", "-", "1"}]}], "]"}], "]"}], ",", "fixed"}], 
                  "}"}]}], "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"lo", "=", 
             RowBox[{"Quiet", "@", 
              RowBox[{"LinearOptimization", "[", 
               RowBox[{
                RowBox[{"cv", "[", 
                 RowBox[{"[", "k", "]"}], "]"}], ",", "cs", ",", "cv", 
                ",", "\"\<PrimalMinimumValue\>\""}], "]"}]}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"NumericQ", "@", "lo"}], ",", 
              RowBox[{
               RowBox[{"hi", "=", 
                RowBox[{"-", 
                 RowBox[{"LinearOptimization", "[", 
                  RowBox[{
                   RowBox[{"-", 
                    RowBox[{"cv", "[", 
                    RowBox[{"[", "k", "]"}], "]"}]}], ",", "cs", ",", "cv", 
                   ",", "\"\<PrimalMinimumValue\>\""}], "]"}]}]}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"Do", "[", 
                RowBox[{
                 RowBox[{"go", "[", 
                  RowBox[{"Append", "[", 
                   RowBox[{"fixed", ",", "j"}], "]"}], "]"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"j", ",", 
                   RowBox[{"Ceiling", "[", 
                    RowBox[{"lo", "-", 
                    RowBox[{"10", "^", 
                    RowBox[{"-", "6"}]}]}], "]"}], ",", 
                   RowBox[{"Floor", "[", 
                    RowBox[{"hi", "+", 
                    RowBox[{"10", "^", 
                    RowBox[{"-", "6"}]}]}], "]"}]}], "}"}]}], "]"}]}]}], 
             "]"}]}]}], "]"}]}], "]"}]}], ";"}], "*)"}], 
    "\[IndentingNewLine]", "]"}], "//", "Time"}]}]], "Input",
 CellChangeTimes->{{3.999262254276819*^9, 3.999262281200276*^9}, {
