Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Calculate", " ", "Boundaries", " ", "in", " ", 
    RowBox[{
     RowBox[{"TIM", "^", "2"}], "/", "Z_"}], "2", " ", "and", " ", "Pull", " ",
     "back", " ", "to", " ", 
    RowBox[{"TIM", "^", "2"}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Module", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "md", ",", "s", ",", " ", "z", ",", " ", "t", ",", "boundaries", ",", 
       " ", "defects", ",", " ", "x", ",", " ", "xz", ",", " ", "pullbacks", ",",
        "untwisted", ",", "transmission"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"md", "=", 
       RowBox[{"ModularDataFoldZ2OrbifoldMinimal", "[", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"s", "=", 
       RowBox[{"md", "[", "\"\<S\>\"", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"t", "=", 
       RowBox[{"md", "[", "\"\<T\>\"", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"z", "=", 
       RowBox[{"md", "[", "\"\<Z\>\"", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"md", "[", "\"\<irreps\>\"", "]"}], "[", "\"\<weights\>\"", 
        "]"}], " ", "//", "Echo"}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{"Calculate", " ", "boundaries"}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"boundaries", " ", "=", " ", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"#", "/", 
            RowBox[{"Sqrt", "[", 
             RowBox[{"#", "[", 
              RowBox[{"[", "1", "]"}], "]"}], "]"}]}], " ", "&"}], " ", "/@", 
          " ", "s"}], "//", "Simplify"}], "//", "Transpose"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{
         RowBox[{"boundaries", "//", "MatrixPlot"}], "//", "Echo"}], ";"}], 
       "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
       "The", " ", "defects", " ", "in", " ", "here", " ", "to", " ", "find", 
        " ", "the", " ", "inverse", " ", "Z2"}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"defects", "=", " ", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"#", "/", 
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], " ", "&"}], " ", "/@", " ", 
          "s"}], "//", "Simplify"}], "//", "Transpose"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{
         RowBox[{"defects", "//", "MatrixForm"}], "//", "Echo"}], ";"}], 
       "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{
        "It", " ", "looks", " ", "like", " ", "there", " ", "are", " ", "3", " ",
          "Z_", 
         RowBox[{"2", "'"}], "s", " ", "in", " ", "there", " ", "in", " ", 
         "a", " ", "Z_", 
         RowBox[{"2", "^", "2"}]}], ",", " ", "\[IndentingNewLine]", "   ", 
        RowBox[{"so", " ", "which", " ", "one", " ", "is", " ", "the", " ", 
         RowBox[{"inverse", "?", " ", "\[IndentingNewLine]", 
          RowBox[{"(", 
           RowBox[{"probably", " ", "the", " ", "diagonal", " ", "one"}], 
           ")"}]}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"x", " ", "=", " ", 
       RowBox[{"defects", "[", 
        RowBox[{"[", 
         RowBox[{"-", "5"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{"Let", "'"}], "s", " ", "check", " ", "if", " ", "it", " ", 
        "is"}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"xz", " ", "=", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"x", "*", "#"}], "&"}], "/@", "z"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"z", " ", "+", " ", "xz", " ", "+", " ", 
            RowBox[{"s", " ", ".", " ", "xz", " ", ".", " ", "s"}], " ", "+", 
            " ", 
            RowBox[{
            "t", " ", ".", " ", "s", " ", ".", " ", "xz", " ", ".", " ", "s", 
             " ", ".", " ", 
             RowBox[{"ConjugateTranspose", "[", "t", "]"}]}]}], ")"}], "/", 
          "2"}], "//", " ", "N"}], "//", "Chop"}], " ", "//", " ", 
       RowBox[{"MatrixPlot", "/", "Echo"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{"Ok", " ", "it", " ", 
         RowBox[{"isn", "'"}], "t", " ", "the", " ", "last", " ", "one"}], ",",
         " ", 
        RowBox[{
        "but", " ", "it", " ", "is", " ", "the", " ", "one", " ", "I", " ", 
         "picked", " ", "because", " ", "I", " ", "now", " ", "have", " ", 
         "checked", " ", "lol"}]}], " ", "*)"}], "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "The", " ", "pullback", " ", "is", " ", "going", " ", "to", " ", 
        "be"}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"pullbacks", " ", "=", " ", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"#", " ", "+", " ", 
             RowBox[{"x", " ", "*", " ", "#"}]}], ")"}], "/", 
           RowBox[{"Sqrt", "[", "2", "]"}]}], "&"}], "/@", " ", 
         "boundaries"}], " ", "//", "Simplify"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"untwisted", " ", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Abs", "[", 
             RowBox[{"#", "[", 
              RowBox[{"[", "3", "]"}], "]"}], "]"}], "<", "2"}], ",", "1", ",",
            "0"}], "]"}], "&"}], "/@", 
        RowBox[{
         RowBox[{"md", "[", "\"\<irreps\>\"", "]"}], "[", "\"\<labels\>\"", 
         "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"{", "untwisted", "}"}], "//", "MatrixPlot"}], "//", "Echo"}],
       ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"Select", "[", 
         RowBox[{"pullbacks", ",", 
          RowBox[{
           RowBox[{
            RowBox[{"#", " ", "*", " ", "untwisted"}], "==", " ", "#"}], 
           "&"}]}], "]"}], "//", "MatrixPlot"}], "//", "Echo"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"transmission", "=", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "-", 
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", 
               RowBox[{"-", "5"}], "]"}], "]"}], "/", 
             RowBox[{"#", "[", 
              RowBox[{"[", "1", "]"}], "]"}]}]}], ")"}], "/", "2"}], "&"}], "/@", 
        RowBox[{"Select", "[", 
