          RowBox[{
           RowBox[{
            RowBox[{"#", "*", "untwisted"}], "==", "#"}], "&"}]}], 
         "]"}]}]}]}]}], "\[IndentingNewLine]", "]"}], "//", 
   "Time"}]}]], "Input",
